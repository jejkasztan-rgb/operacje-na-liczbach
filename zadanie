echo ($a + 3) . "<br>";
echo ($a - 5) . "<br>";
echo ($a * 2) . "<br>";
echo ($a / 5) . "<br>";
echo ($a % 2) . "<br>";
 
echo ($a ^ 3) . "<br>";
 
